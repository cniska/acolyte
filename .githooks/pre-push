#!/usr/bin/env bash
set -euo pipefail

# Reject commits that don't follow project conventions
root=$(git rev-parse --show-toplevel)
remote="$1"

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # New ref — only check commits not already on the remote
    if git remote get-url "$remote" >/dev/null 2>&1; then
      range=("$local_oid" --not --remotes="$remote")
    else
      # A direct URL has no local tracking namespace, so validate every ancestor
      # rather than excluding commits that may belong only to another remote.
      range=("$local_oid")
    fi
  else
    range=("$remote_oid..$local_oid")
  fi
  bash "$root/scripts/check-commits.sh" "${range[@]}" || exit 1
done

# Git exports GIT_DIR and friends into hooks. verify runs the test suite, and a test that
# shells out to git inherits them and operates on this repository instead of its own fixture.
for key in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$key" 2>/dev/null || true
done

bun run verify
