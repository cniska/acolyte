#!/usr/bin/env bash
set -euo pipefail

# Reject commits that don't follow project conventions
root=$(git rev-parse --show-toplevel)
remote="$1"

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    # New ref — only check commits not already on the remote
    if git remote get-url "$remote" >/dev/null 2>&1; then
      range=("$local_oid" --not --remotes="$remote")
    else
      range=("$local_oid" --not --remotes)
    fi
  else
    range=("$remote_oid..$local_oid")
  fi
  if ! commits=$(git rev-list "${range[@]}"); then
    echo "error: cannot enumerate commits for $local_ref." >&2
    exit 1
  fi
  if [ -z "$commits" ]; then
    continue
  fi
  while IFS= read -r oid; do
    subject=$(git log -1 --format='%s' "$oid")
    body=$(git log -1 --format='%b' "$oid")
    bash "$root/scripts/check-commit-message.sh" "$subject" "$body" || {
      echo "  commit: $oid" >&2
      exit 1
    }
    author_name=$(git log -1 --format='%an' "$oid")
    author_email=$(git log -1 --format='%ae' "$oid")
    committer_name=$(git log -1 --format='%cn' "$oid")
    committer_email=$(git log -1 --format='%ce' "$oid")
    bash "$root/scripts/check-commit-author.sh" "$author_name" "$author_email" author || {
      echo "  commit: $oid" >&2
      exit 1
    }
    bash "$root/scripts/check-commit-author.sh" "$committer_name" "$committer_email" committer || {
      echo "  commit: $oid" >&2
      exit 1
    }
  done <<< "$commits"
done

bun run verify
